{
  "expo": {
    "name": "FULafia Cottage Hospital EMR",
    "slug": "fulafia-cottage-hospital-emr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fulafiahospitalemr",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "icon": "./assets/images/icon.png",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fulafia.cottagehospital.emr"
    },

    "android": {
      "package": "com.fulafia.cottagehospital.emr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#034C40"
      },
      "edgeToEdgeEnabled": true
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#034C40",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "7762a6b8-e75a-4d2f-9346-95e01a71ace2"
      }
    }
  }
}