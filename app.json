{
  "expo": {
    "name": "FULafia Cottage Hospital EMR",
    "slug": "fulafia-cottage-hospital-emr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fulafiahospitalemr",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fulafia.cottagehospital.emr"
    },
    "android": {
      "package": "com.fulafia.cottagehospital.emr",
      "adaptiveIcon": {
        "backgroundColor": "#034C40"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#034C40",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}